# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/dbname
DATABASE_URL_SYNC=postgresql://user:password@localhost:5432/dbname

# AWS Bedrock
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# External APIs
APOLLO_API_KEY=your_apollo_api_key_here
APOLLO_BASE_URL=https://api.apollo.io/v1

EXA_API_KEY=your_exa_api_key_here
EXA_BASE_URL=https://api.exa.ai

HUNTER_API_KEY=your_hunter_api_key_here
HUNTER_BASE_URL=https://api.hunter.io/v2

LUSHA_API_KEY=your_lusha_api_key_here
LUSHA_BASE_URL=https://api.lusha.com

CLAY_API_KEY=your_clay_api_key_here
CLAY_BASE_URL=https://api.clay.com

TAVILY_API_KEY=your_tavily_api_key_here
TAVILY_BASE_URL=https://api.tavily.com

SIMFIN_API_KEY=your_simfin_api_key_here
NEWS_API_KEY=your_news_api_key_here
FRED_API_KEY=your_fred_api_key_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
ALLOWED_EMAIL_DOMAIN=yourdomain.com

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
